# ---- server ----
PORT=8787
# Public URL of the web app (used for LiveKit egress to open /program/:id)
PUBLIC_URL=http://localhost:5180
# Encrypts RTMP stream keys at rest (AES-256-GCM). Generate: openssl rand -hex 32
STREAM_KEY_SECRET=
DATA_DIR=data

# ---- scaling (optional) ----
# REDIS_URL=redis://localhost:6379        # shared ESPN poller lock + pub/sub + Socket.IO adapter
# DATABASE_URL=postgres://user:pass@host:5432/cricstudio   # default: built-in SQLite

# ---- media ----
# mesh    = P2P WebRTC + host-browser compositor + server FFmpeg fan-out (no extra infra)
# livekit = LiveKit SFU + Web Egress renders the program in the cloud
MEDIA_MODE=mesh
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# TURN for guests behind strict NATs (mesh mode), e.g. coturn / Cloudflare / Twilio
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---- encoder ----
FFMPEG_PATH=ffmpeg
# auto = pass the browser's H.264 straight through (very low CPU); x264 = always re-encode
ENCODER_MODE=auto
VIDEO_BITRATE_KBPS=4500
AUDIO_BITRATE_KBPS=160
X264_PRESET=veryfast

# ---- 24/7 cloud producer (headless Chrome renders + streams the show) ----
# CHROME_PATH=/usr/bin/chromium          # auto-detected on Windows/macOS/Linux
# INTERNAL_WEB_URL=http://127.0.0.1:8787 # page the producer opens (defaults to this server in production)
WORKER_RECYCLE_HOURS=6                   # restart the producer every N hours (RTMP stays connected)
WORKER_MAX_HEAP_MB=900                   # restart if the producer page grows beyond this
HOST_FAILOVER_MS=8000                    # host browser drops while live → cloud takes over after this

# ---- AssemblyAI (commentator voice, realtime captions, voice agent, LLM Gateway) ----
# Server-side only; browsers get short-lived tokens. Studios can also save their own key.
ASSEMBLYAI_API_KEY=
# Optional LLM Gateway model for commentary/recaps (falls back to qwen3.5-4b-32k-fast)
# COMMENTARY_MODEL=claude-haiku-4-5-20251001
# Offline fallback voice (Microsoft Edge neural) when AssemblyAI is unreachable
TTS_VOICE=en-IN-PrabhatNeural

# ---- ESPN polling ----
POLL_LIVE_MS=6000
POLL_IDLE_MS=60000
SCOREPANEL_TTL_MS=20000
DEMO_BALL_MS=4500
